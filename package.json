{
  "name": "dagger-action",
  "version": "1.0.0",
  "description": "GitHub Action for Dagger with intelligent caching",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun build src/main.ts --outfile dist/index.js --target node --format cjs --minify",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --write",
    "fmt": "biome format . --write",
    "fmt:check": "biome format ."
  },
  "keywords": [
    "dagger",
    "github-actions",
    "ci-cd",
    "cache"
  ],
  "os": [
    "linux"
  ],
  "license": "BlueOak-1.0.0",
  "dependencies": {
    "@actions/cache": "6.1.0",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "24.10.13",
    "typescript": "6.0.3",
    "bun-types": "1.3.14"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24.0.0"
  }
}
